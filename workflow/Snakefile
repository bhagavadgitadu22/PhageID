import os


workdir: workflow.current_basedir


wildcard_constraints:
    sample="[^/]+",
    readset="filtered|all",


### Configuration
configfile: workflow.source_path("../config/config.yaml")


ENV_DIR = os.path.normpath(os.path.join(workflow.current_basedir, "../envs"))
SAMPLES_FILE = config["samples_file"]
RESULTS_DIR = config["results_dir"]
SAMPLE_DATA_ROOT = config["sample_data_root"]


include: "common.smk"


# list of phages
with open(SAMPLES_FILE) as f:
    READ_FILES = {}
    SHORT_READS = {}
    HOSTS_LIST = {}

    for line in f:
        if line.strip():
            fields = line.rstrip("\r\n").split("\t")
            sample, r1 = fields[:2]
            host = fields[3].strip() if len(fields) > 3 else ""
            r1 = r1.strip()
            short = fields[2].strip() if len(fields) > 2 else ""
            READ_FILES[sample] = sample_path(r1)
            SHORT_READS[sample] = sample_path(short)
            if not READ_FILES[sample] and not SHORT_READS[sample]:
                raise ValueError(f"No long or short reads supplied for {sample}")
            HOSTS_LIST[sample] = sample_path(host)

PHAGES_LIST = list(READ_FILES.keys())


# Rank by the highest CheckV category among each assembly's retained viral contigs.
CHECKV_QUALITY_RANK = {
    "Not-determined": 1,
    "Low-quality": 2,
    "Medium-quality": 3,
    "High-quality": 4,
    "Complete": 5,
}


ASSEMBLY_DATABASES = ("genomad_db", "checkv_db")
ANNOTATION_DATABASES = ("pharokka_db", "phold_db", "checkamg_db")
COMPARISON_DATABASES = ("vcontact3_db",)


### Rules to include
# Function to recursively include all .smk files
# Include all .smk files from the rules directory and subdirectories
for root, _, files in os.walk(os.path.join(workflow.current_basedir, "rules")):
    for file in sorted(files):
        if file.endswith(".smk"):

            include: os.path.join(root, file)


# Copy/report selection must run in the controller after checkpoint inputs resolve.
localrules:
    assembly_selection_manifest,
    select_viral_assembly,


### Global rules
# Assembly rules
rule corrected_assembly_all_phages:
    input:
        preflight=preflight_inputs(assembly_databases()),
        read_stats=rules.all_reads_stats.input,
        assembly=lambda wildcards: checkpoints.viral_report_global.get().output,


# Three rules to rule them all
rule pipeline_new_phage:
    output:
        os.path.join(RESULTS_DIR, "{sample}", "done.touch"),
    input:
        preflight=preflight_inputs(assembly_databases() + ANNOTATION_DATABASES),
        outputs=per_sample_pipeline_inputs,
    log:
        os.path.join(RESULTS_DIR, "logs", "{sample}_pipeline_new_phage.log"),
    conda:
        os.path.join(ENV_DIR, "utility.yaml")
    shell:
        """touch {output:q} > {log:q} 2>&1"""


rule pipeline_all_phages:
    default_target: True
    input:
        preflight=preflight_inputs(assembly_databases() + ANNOTATION_DATABASES),
        read_stats=rules.all_reads_stats.input,
        assembly=lambda wildcards: checkpoints.viral_report_global.get().output,
        annotations=rules.viral_annotations_report_global.output,
        samples=active_sample_files(os.path.join(RESULTS_DIR, "{sample}", "done.touch")),


rule pipeline_comparison_phages:
    output:
        os.path.join(RESULTS_DIR, "combined_viruses", "done.touch"),
    input:
        preflight=preflight_inputs(
            assembly_databases() + ANNOTATION_DATABASES + COMPARISON_DATABASES
        ),
        outputs=comparison_pipeline_inputs,
    log:
        os.path.join(RESULTS_DIR, "logs", "pipeline_comparison_phages.log"),
    conda:
        os.path.join(ENV_DIR, "utility.yaml")
    shell:
        """touch {output:q} > {log:q} 2>&1"""
