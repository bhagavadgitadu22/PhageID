import os

wildcard_constraints:
    sample="[^/]+",
    readset="filtered|all"

### Configuration
configfile: os.getcwd()+"/../config/config.yaml"

ENV_DIR = os.getcwd()+"/../envs"
SAMPLES_FILE = config["samples_file"]
RESULTS_DIR = config["results_dir"]

# list of phages
with open(SAMPLES_FILE) as f:
    READ_FILES = {}
    SHORT_READS = {}
    HOSTS_LIST = {}

    for line in f:
        if line.strip():
            fields = line.rstrip("\r\n").split("\t")
            sample, r1 = fields[:2]
            host = fields[3].strip() if len(fields) > 3 else ""
            missing = {"", "na", "none", "-"}
            r1 = r1.strip()
            short = fields[2].strip() if len(fields) > 2 else ""
            READ_FILES[sample] = "" if r1.lower() in missing else r1
            SHORT_READS[sample] = "" if short.lower() in missing else short
            if not READ_FILES[sample] and not SHORT_READS[sample]:
                raise ValueError(f"No long or short reads supplied for {sample}")
            HOSTS_LIST[sample] = "" if host.lower() in {"", "na", "none", "-"} else host

PHAGES_LIST = list(READ_FILES.keys())

def read_input_files(path):
    if not path:
        raise ValueError("No read input supplied")
    if not os.path.isdir(path):
        return [path]
    files = [os.path.join(path, name) for name in sorted(os.listdir(path))
             if name.lower().endswith((".fastq", ".fq", ".fastq.gz", ".fq.gz"))
             and os.path.isfile(os.path.join(path, name))]
    if not files:
        raise ValueError(f"No FASTQ files found in {path}")
    return files

def sample_reads(wildcards):
    pattern = (rules.preprocess_reads_porechop.output[0] if READ_FILES[wildcards.sample]
               else rules.preprocess_reads_fastp.output.reads)
    return pattern.format(sample=wildcards.sample)

def assembly_reads(wc):
    if wc.readset == "filtered":
        return rules.remove_bacterial_contamination.output[0].format(sample=wc.sample)
    return sample_reads(wc)

def candidate_assembly(wc):
    if wc.assembler in {"flye", "autocycler"} and not READ_FILES[wc.sample]:
        raise ValueError(f"{wc.assembler} requires long reads for {wc.sample}")
    return os.path.join(RESULTS_DIR, wc.sample, "assembly_attempts", wc.readset, wc.assembler, "assembly.fasta")

# Rank by the highest CheckV category among each assembly's retained viral contigs.
CHECKV_QUALITY_RANK = {"Not-determined": 1, "Low-quality": 2, "Medium-quality": 3,
                      "High-quality": 4, "Complete": 5}

def candidate_choice(sample, readset, dependencies=None):
    import csv
    primary = "flye" if READ_FILES[sample] else "spades"
    def quality(assembler):
        candidate = checkpoints.candidate_viral_quality.get(sample=sample, readset=readset, assembler=assembler).output
        if dependencies is not None:
            dependencies.extend([str(candidate.quality), str(candidate.status)])
        with open(candidate.status) as handle:
            status = handle.read().strip()
        if status == "failed":
            return -1
        if status != "success":
            raise ValueError(f"Invalid assembly status: {status}")
        with open(candidate.quality) as handle:
            return max((CHECKV_QUALITY_RANK.get(row["checkv_quality"], 1)
                        for row in csv.DictReader(handle, delimiter="\t")), default=0)
    primary_quality = quality(primary)
    if primary == "spades" or primary_quality >= CHECKV_QUALITY_RANK["High-quality"]:
        return primary, primary_quality
    autocycler_quality = quality("autocycler")
    # Prefer the earlier attempt when the best categories are equal.
    if autocycler_quality > primary_quality:
        return "autocycler", autocycler_quality
    return primary, primary_quality

def selected_candidate_inputs(wc, dependencies=None):
    import csv
    filter_report = checkpoints.assembly_read_status.get(sample=wc.sample).output[0]
    if dependencies is not None:
        dependencies.append(str(filter_report))
    with open(filter_report) as handle:
        stats = next(csv.DictReader(handle, delimiter="\t"))
    readset = "filtered" if HOSTS_LIST[wc.sample] and int(stats["Bacterial free reads"]) > 0 else "all"
    assembler, best_quality = candidate_choice(wc.sample, readset, dependencies)
    if readset == "filtered" and best_quality < CHECKV_QUALITY_RANK["High-quality"]:
        all_assembler, all_quality = candidate_choice(wc.sample, "all", dependencies)
        if all_quality > best_quality:
            readset, assembler = "all", all_assembler
    values = dict(rules.fix_circular_viral_contigs_per_sample_candidate.output.items())
    values.update(dict(rules.genomad_candidate.output.items()))
    values.update(dict(rules.checkv_candidate.output.items()))
    values["status"] = os.path.join(RESULTS_DIR, "{sample}", "assembly_attempts", "{readset}", "{assembler}", "assembly_status.txt")
    values["assembly"] = os.path.join(RESULTS_DIR, "{sample}", "assembly_attempts", "{readset}", "{assembler}", "assembly.fasta")
    if assembler == "flye":
        values["flye_info"] = rules.assembly_reads_flye.output.info
        values["used_reads"] = rules.subsample_reads_flye.output.reads
    else:
        values["used_reads"] = (rules.remove_bacterial_contamination.output[0] if readset == "filtered" else sample_reads(wc))
    values["filter_report"] = filter_report
    return {name: str(path).format(sample=wc.sample, assembler=assembler, readset=readset) for name, path in values.items()}

def selection_manifest_inputs(wc):
    dependencies = []
    sources = selected_candidate_inputs(wc, dependencies)
    # Track every assessed candidate, including those that lost the comparison.
    return list(dict.fromkeys(dependencies + list(sources.values())))

def sample_mapper(wildcards):
    return "minimap2-ont" if READ_FILES[wildcards.sample] else "minimap2-sr-secondary"

def active_viral_samples(wildcards):
    import csv
    report_directory = checkpoints.viral_report_global.get().output.report
    with open(os.path.join(report_directory, "samples.tsv"), newline="") as handle:
        return [row["Sample"] for row in csv.DictReader(handle, delimiter="\t") if row["Status"] == "ready"]

def active_sample_files(pattern):
    return lambda wildcards: expand(pattern, sample=active_viral_samples(wildcards))

def per_sample_pipeline_inputs(wildcards):
    report_directory = checkpoints.viral_report_global.get().output.report
    if wildcards.sample not in PHAGES_LIST:
        raise ValueError(f"Unknown sample: {wildcards.sample}")
    if wildcards.sample not in active_viral_samples(wildcards):
        return [report_directory]
    outputs = [*rules.phageterm.output,
               *rules.pharokka_plot.output, *rules.genotate_pharokka_plot.output,
               rules.antiDefenseFinder.output.systems,
               *rules.combine_empathi_with_sublyme.output, *rules.checkamg.output]
    return expand(outputs, sample=wildcards.sample)

def comparison_pipeline_inputs(wildcards):
    report_directory = checkpoints.viral_report_global.get().output.report
    if not active_viral_samples(wildcards):
        return [report_directory]
    return [report_directory, rules.ani_for_dereplication.output.ani_results,
            *rules.viruses_dereplicated.output, *rules.dereplication_report.output, *rules.lovis4u_pharokka.output,
            *rules.thebigbam_calculate.output, *rules.thebigbam_calculate_post_dereplication.output, *rules.vcontact3.output]

### Rules to include
# Function to recursively include all .smk files
def include_smk_files(directory):
    for root, _, files in os.walk(directory):
        files.sort()
        for file in files:
            if file.endswith('.smk'):
                include: os.path.join(root, file)

# Include all .smk files from the rules directory and subdirectories
include_smk_files('rules/')

# Copy/report selection must run in the controller after checkpoint inputs resolve.
localrules: assembly_selection_manifest, select_viral_assembly

### Global rules
# Assembly rules
rule corrected_assembly_all_phages:
    input: lambda wildcards: checkpoints.viral_report_global.get().output.report

# Three rules to rule them all
rule pipeline_new_phage:
    output: os.path.join(RESULTS_DIR, "{sample}", "done.touch")
    input: per_sample_pipeline_inputs
    shell: """touch {output}"""

rule pipeline_all_phages:
    default_target: True
    input:
        report=lambda wildcards: checkpoints.viral_report_global.get().output.report,
        samples=active_sample_files(os.path.join(RESULTS_DIR, "{sample}", "done.touch"))

rule pipeline_comparison_phages:
    output: os.path.join(RESULTS_DIR, "combined_viruses", "done.touch")
    input: comparison_pipeline_inputs
    shell: """touch {output}"""
